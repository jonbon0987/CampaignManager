# Required — Supabase project credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — E2E / AI auto-login (dev mode only)
# Navigate to /?auto-login to trigger automatic sign-in with these credentials.
# Only works when the Vite dev server is running (import.meta.env.DEV === true).
VITE_E2E_USER_EMAIL=
VITE_E2E_USER_PASSWORD=
