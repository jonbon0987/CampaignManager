# Required — Supabase project credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required for `npm run migrate` — Supabase Postgres connection string (URI).
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the direct/session connection (port 5432), not the pooled transaction port.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Required for the AI assistant — server-side keys for the /api functions.
# These are read by the Vercel serverless functions (api/_ai.ts), NOT the
# browser, so they are NOT prefixed with VITE_. In production they must be set
# in your host's environment variables (e.g. Vercel -> Settings -> Environment
# Variables) with the Production scope — .env.local is never deployed.
#
# Default provider is Gemini (free tier) — GOOGLE_AI_API_KEY is required.
# Free key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Optional — override the Gemini model. Defaults to gemini-3.5-flash-lite
# (cheaper/faster Flash tier, free-tier eligible per the AI Studio rate-limits
# table). If your account/region lacks free access to it, fall back to
# gemini-3.5-flash or gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional — only needed if you switch to Claude (VITE_AI_PROVIDER=claude).
ANTHROPIC_API_KEY=
# Optional — which provider the API functions use. "gemini" (default) or "claude".
VITE_AI_PROVIDER=gemini

# Optional — E2E / AI auto-login (dev mode only)
# Navigate to /?auto-login to trigger automatic sign-in with these credentials.
# Only works when the Vite dev server is running (import.meta.env.DEV === true).
VITE_E2E_USER_EMAIL=
VITE_E2E_USER_PASSWORD=
