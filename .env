# Local development environment — NEVER commit real keys
# Copy values from .env.local for development
# .env.local is git-ignored and should contain real credentials

# Server-only (used by Vercel serverless functions + `vercel dev`)
ANTHROPIC_API_KEY=your-anthropic-key-here

VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key